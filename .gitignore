# macOS
.DS_Store

# Secrets. Never commit keys.
.env

# Generated world data. Recreate with: uv run python -m seed.generate
data/cartwheel.db

# Local conversation state and scenario/replay run outputs.
.sessions.db
scenarios/results/
replay/results/
.harbor/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

*.db-shm
.sessions.db-wal

scenarios/demo_pilot_gt.json

# Locally installed agent skills (npx skills add). The course's own
# .agents/skills/agent-profiler stays tracked.
.agents/skills/*
!.agents/skills/agent-profiler/
.claude/skills/
skills-lock.json
